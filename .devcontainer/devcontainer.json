{
  "name": "NewSQL Web Lab",

  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "forwardPorts": [
    8501,
    8080
  ],

  "portsAttributes": {
    "8501": {
      "label": "Streamlit - NewSQL App",
      "onAutoForward": "openBrowser"
    },
    "8080": {
      "label": "CockroachDB Console",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "settings": {
        "files.eol": "\n",
        "files.insertFinalNewline": true
      }
    }
  },

  "postCreateCommand": "sed -i 's/\\r$//' setup.sh start.sh && chmod +x setup.sh start.sh && bash setup.sh",

  "postStartCommand": "nohup bash start.sh > /tmp/newsql-start.log 2>&1 &"
}
